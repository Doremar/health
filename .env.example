# Абсолютный путь к директории health внутри vault (см. docs/SETUP_MACMINI.md).
# Сюда watcher смотрит inbox/, importer пишет markdown/originals/db.sqlite.
HEALTH_VAULT_PATH=/Users/<user>/Documents/AI/health

# Путь к Claude Code CLI (обычно просто `claude`, если установлен глобально)
# Importer и telegram-бот вызывают `claude -p` для парсинга PDF и фото.
# Нужна активная подписка Claude Pro/Max на этом аккаунте.
CLAUDE_BIN=claude

# Токен Telegram-бота от @BotFather (см. docs/SETUP_MACMINI.md).
TELEGRAM_BOT_TOKEN=

# (опционально) расписание опросов самочувствия в МСК. Дефолт: 10:00,15:00,21:00
# FEELING_TIMES=10:00,15:00,21:00

# (опционально, для Whoop OAuth — пока не подключаем)
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=http://localhost:8765/callback
